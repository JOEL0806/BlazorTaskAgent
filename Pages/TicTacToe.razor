@page "/tic-tac-toe"

<h3>Tic-Tac-Toe</h3>

<p>
    Player Wins: @playerWins |
    Computer Wins: @computerWins
</p>

<table>
    @for (int r = 0; r < 3; r++)
    {
        <tr>
            @for (int c = 0; c < 3; c++)
            {
                int index = r * 3 + c;
                <td style="padding:10px">
                    <button style="width:60px;height:60px;font-size:24px"
                            disabled="@(!availableMoves.Contains(index))"
                            @onclick="() => PlayerMove(index)">
                        @board[index]
                    </button>
                </td>
            }
        </tr>
    }
</table>

@if (!string.IsNullOrEmpty(message))
{
    <p><strong>@message</strong></p>
    <button @onclick="ResetGame">Play Again</button>
}

@code {
    char[] board = new char[9];
    List<int> availableMoves = new();
    Random rand = new();

    int playerWins = 0;
    int computerWins = 0;
    string message;

    protected override void OnInitialized()
    {
        ResetGame();
    }

    void ResetGame()
    {
        message = "";
        availableMoves.Clear();

        for (int i = 0; i < 9; i++)
        {
            board[i] = '-';
            availableMoves.Add(i);
        }
    }

    async Task PlayerMove(int index)
    {
        if (!availableMoves.Contains(index)) return;

        board[index] = 'X';
        availableMoves.Remove(index);

        if (CheckWin('X'))
        {
            message = "Player Wins!";
            playerWins++;
            return;
        }

        if (availableMoves.Count == 0)
        {
            message = "It's a Draw!";
            return;
        }

        await Task.Delay(500); // AI thinking delay
        ComputerMove();

        if (CheckWin('O'))
        {
            message = "Computer Wins!";
            computerWins++;
        }
    }

    void ComputerMove()
    {
        if (availableMoves.Count == 0) return;

        int move = availableMoves[rand.Next(availableMoves.Count)];
        board[move] = 'O';
        availableMoves.Remove(move);
    }

    bool CheckWin(char p)
    {
        int[,] wins =
        {
            {0,1,2},{3,4,5},{6,7,8},
            {0,3,6},{1,4,7},{2,5,8},
            {0,4,8},{2,4,6}
        };

        for (int i = 0; i < wins.GetLength(0); i++)
        {
            if (board[wins[i,0]] == p &&
                board[wins[i,1]] == p &&
                board[wins[i,2]] == p)
                return true;
        }
        return false;
    }
}